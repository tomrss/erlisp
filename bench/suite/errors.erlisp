;;;;; errors: signal and condition-case
;;
;; 20000 signals, each one raised 10 calls deep and caught by a
;; condition-case: measures handler setup and non local exit through
;; the stack. will be interesting with CEK and call/cc.

(define (deep n)
  (if (< n 1)
      (signal 'bench-error)
      (+ 1 (deep (- n 1)))))

(define (try-once)
  (condition-case e (deep 10)
    (bench-error 1)))

;; sum of the results of n calls of (f)
(define (sum-times n f)
  (if (< n 1)
      0
      (+ (f) (sum-times (- n 1) f))))

(format t "~a~%" (number->string
                  (sum-times 200 (lambda ()
                    (sum-times 100 try-once)))))
