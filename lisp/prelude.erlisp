;;; quasiquotation

(define (qq-expand x)
  (cond
   ((nil? (cons? x))
    (cons 'quote (cons x nil)))
   ((eq? (car x) 'unquote)
    (car (cdr x)))
   ((and (cons? (car x)) (eq? (car (car x)) 'unquote-splicing))
    (cons 'append (cons (car (cdr (car x))) (cons (qq-expand (cdr x)) nil))))
   (t
    (cons 'cons (cons (qq-expand (car x)) (cons (qq-expand (cdr x)) nil))))))

(defmacro (quasiquote x)
    (qq-expand x))


;;; primitives

(define (caar c) (car (car c)))
(define (cdar c) (cdr (car c)))
(define (caaar c) (car (car (car c))))
(define (caadr c) (car (car (cdr c))))
(define (cadar c) (car (cdr (car c))))
(define (caddr c) (car (cdr (cdr c))))
(define (cdaar c) (cdr (car (car c))))
(define (cdadr c) (cdr (car (cdr c))))
(define (cddar c) (cdr (cdr (car c))))
(define (cdddr c) (cdr (cdr (cdr c))))

(defmacro (when c . body)
  `(if ,c (progn ,@body)))

(defmacro (unless c . body)
  `(if ,c nil ,@body))

(define (map fun l)
  (if l
      (cons
       (fun (car l))
       (map fun (cdr l)))
      nil))

(defmacro (let args . body)
  `((lambda ,(map car args)
      ,@body)
    ,@(map cadr args)))

(defmacro (let* args . body)
  (if args
      `(let ((,(caar args) ,(cadar args)))
         (let* ,(cdr args) ,@body))
      `(progn ,@body)))

(defmacro (letrec* args . body)
  `((lambda ()
      ,(map ,(lambda (x)
               `(define (car x) (cadr x)))
            (car args))
      ,@body)
    ,@(map cadr args)))

(define (list . rest)
  rest)


;;;; ports

(define (call-with-port port proc)
  (unwind-protect
      (proc port)
    (close-port port)))

(define (with-output-to-port port thunk)
  (let ((old (current-output-port)))
    (set-current-output-port! port)
    (unwind-protect
        (thunk)
      (set-current-output-port! old))))

(define (with-output-to-string thunk)
  (call-with-port (open-output-string)
    (lambda (p)
      (with-output-to-port p
        (lambda ()
          (thunk)
          (get-output-string p))))))

(define (with-output-to-file path thunk)
  (call-with-port (open-output-file path)
    (lambda (p)
      (with-output-to-port p
        thunk))))

(define (with-input-from-port port thunk)
  (let ((old (current-input-port)))
    (set-current-input-port! port)
    (unwind-protect
        (thunk)
      (set-current-input-port! old))))

(define (with-input-from-file path thunk)
  (call-with-port (open-input-file path)
    (lambda (p)
      (with-input-from-port p
        thunk))))

(define (with-input-from-string string thunk)
  (call-with-port (open-input-string string)
    (lambda (p)
      (with-input-from-port p
        thunk))))
