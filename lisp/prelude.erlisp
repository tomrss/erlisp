;;; quasiquotation

(define (qq-expand x)
  (cond
   ((nil? (cons? x))
    (cons 'quote (cons x nil)))
   ((eq? (car x) 'unquote)
    (car (cdr x)))
   ((and (cons? (car x)) (eq? (car (car x)) 'unquote-splicing))
    (cons 'append (cons (car (cdr (car x))) (cons (qq-expand (cdr x)) nil))))
   (t
    (cons 'cons (cons (qq-expand (car x)) (cons (qq-expand (cdr x)) nil))))))

(defmacro (quasiquote x)
  (qq-expand x))

(defmacro (unquote x)
  (signal 'syntax-error '("unquote outside quasiquote")))

(defmacro (unquote-splicing x)
  (signal 'syntax-error '("unquote-splicing outside quasiquote")))

;;; primitives

(define (caar c) (car (car c)))
(define (cdar c) (cdr (car c)))
(define (caaar c) (car (car (car c))))
(define (caadr c) (car (car (cdr c))))
(define (cadar c) (car (cdr (car c))))
(define (caddr c) (car (cdr (cdr c))))
(define (cdaar c) (cdr (car (car c))))
(define (cdadr c) (cdr (car (cdr c))))
(define (cddar c) (cdr (cdr (car c))))
(define (cdddr c) (cdr (cdr (cdr c))))

(defmacro (when c . body)
  `(if ,c (progn ,@body)))

(defmacro (unless c . body)
  `(if ,c nil ,@body))

(define (map fun l)
  (if l
      (cons
       (fun (car l))
       (map fun (cdr l)))
      nil))

(defmacro (let args . body)
  `((lambda ,(map car args)
      ,@body)
    ,@(map cadr args)))

(defmacro (let* args . body)
  (if args
      `(let ((,(caar args) ,(cadar args)))
         (let* ,(cdr args) ,@body))
      `(progn ,@body)))

(define (list . rest)
  rest)

(define (pad-right s n)
  (if (< (string-length s) n)
      (pad-right (concat s " ") n)
      s))


;;;; ports

(define (call-with-port port proc)
  (unwind-protect
      (proc port)
    (close-port port)))

(define (with-output-to-port port thunk)
  (let ((old (current-output-port)))
    (set-current-output-port! port)
    (unwind-protect
        (thunk)
      (set-current-output-port! old))))

(define (with-output-to-string thunk)
  (call-with-port (open-output-string)
    (lambda (p)
      (with-output-to-port p
        (lambda ()
          (thunk)
          (get-output-string p))))))

(define (with-output-to-file path thunk)
  (call-with-port (open-output-file path)
    (lambda (p)
      (with-output-to-port p
        thunk))))

(define (with-input-from-port port thunk)
  (let ((old (current-input-port)))
    (set-current-input-port! port)
    (unwind-protect
        (thunk)
      (set-current-input-port! old))))

(define (with-input-from-file path thunk)
  (call-with-port (open-input-file path)
    (lambda (p)
      (with-input-from-port p
        thunk))))

(define (with-input-from-string string thunk)
  (call-with-port (open-input-string string)
    (lambda (p)
      (with-input-from-port p
        thunk))))

;;; testing

(define (test-fail msg text)
  (signal 'test-failed
          (list (if msg (format nil "~a: ~a" (car msg) text) text))))

(define (test-assert form value msg)
  (unless value
    (test-fail msg (format nil "~s: expected true, got ~s" form value))))

(define (test-assert-equal expected form actual msg)
  (unless (equal? expected actual)
    (test-fail msg (format nil "~s: expected ~s, got ~s" form expected actual))))

(define (test-assert-error errsym form thunk msg)
  (let ((outcome (condition-case
                     err
                     (list 'value (thunk))
                   (t (list 'error (error-symbol err))))))
    (cond
     ((eq? (car outcome) 'value)
      (test-fail msg (format nil "~s: expected error ~s, got ~s"
                             form errsym (cadr outcome))))
     ((nil? (eq? (cadr outcome) errsym))
      (test-fail msg (format nil "~s: expected error ~s, got error ~s"
                             form errsym (cadr outcome)))))))

(defmacro (assert form . msg)
  `(test-assert ',form ,form (list ,@msg)))

(defmacro (assert-equal expected form . msg)
  `(test-assert-equal ,expected ',form ,form (list ,@msg)))

(defmacro (assert-error errsym form . msg)
  `(test-assert-error ,errsym ',form (lambda () ,form) (list ,@msg)))

(define test-cases '())

(defmacro (deftest name . body)
  `(set! test-cases
         (append test-cases (list (cons ',(car name) (lambda () ,@body))))))

(define (test-run-cases test-cases-alist)
  (define failed 0)
  (define executed 0)
  (define (delegate test-cases-alist)
    (when test-cases-alist
      (let* ((head (car test-cases-alist))
             (tail (cdr test-cases-alist))
             (test-name (car head))
             (test-thunk (cdr head)))
        (format t "test   ~a ..." (pad-right (symbol->string test-name) 30))
        (condition-case
            err
            (progn
             (test-thunk)
             (format t "SUCCESS~%"))
          (test-failed
           (format t "FAILED ~s~%" (error-data err))
           (set! failed (+ failed 1)))
          (t
           (format t "FAILED : ~a : ~s~%" (error-symbol err) (error-data err))
           (set! failed (+ failed 1))))
        (set! executed (+ executed 1))
        (delegate tail))))
  (delegate test-cases-alist)
  (format t "~%Test execution completed: ~a executed, ~a failed~%"
          executed failed)
  (if (> failed 0)
      (signal 'test-cases-failed 'nil)))

(define (test-run)
  (test-run-cases test-cases))
