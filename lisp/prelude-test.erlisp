;;; tests for the prelude

;;; quasiquote

(deftest (qq-plain)
  (assert-equal '(a b c) `(a b c)))

(deftest (qq-unquote)
  (assert-equal '(1 2 3) `(1 ,(+ 1 1) 3)))

(deftest (qq-unquote-splicing)
  (assert-equal '(1 2 3 4) `(1 ,@(list 2 3) 4)))

(deftest (qq-quoted-unquote)
  (let ((x 'a))
    (assert-equal '(quote a) `',x)))

(deftest (qq-unquote-outside)
  (assert-error 'syntax-error (macroexpand-1 '(unquote x))))

(deftest (qq-unquote-splicing-outside)
  (assert-error 'syntax-error (macroexpand-1 '(unquote-splicing x))))

;;; cxr

(deftest (cxr-two-levels)
  (assert-equal 1 (caar '((1) 2)))
  (assert-equal '() (cdar '((1) 2)))
  (assert-equal 3 (caddr '(1 2 3))))

(deftest (cxr-three-levels)
  (assert-equal 1 (caaar '(((1)))))
  (assert-equal '(4) (cdddr '(1 2 3 4))))

;;; control

(deftest (when-true)
  (assert-equal 2 (when t 1 2)))

(deftest (when-false)
  (assert-equal '() (when nil 1)))

(deftest (unless-true)
  (assert-equal '() (unless t 1)))

(deftest (unless-false)
  (assert-equal 1 (unless nil 1)))

;;; let

(deftest (let-simple)
  (assert-equal 3 (let ((a 1) (b 2)) (+ a b))))

(deftest (let-shadowing)
  (assert-equal 2 (let ((a 1)) (let ((a 2)) a))))

(deftest (let*-sequential)
  (assert-equal 2 (let* ((a 1) (b (+ a 1))) b)))

(deftest (let*-empty)
  (assert-equal 1 (let* () 1)))

;;; lists

(deftest (list-build)
  (assert-equal '(1 2 3) (list 1 2 3))
  (assert-equal '() (list)))

(deftest (map-apply)
  (assert-equal '(2 3 4) (map (lambda (x) (+ x 1)) '(1 2 3)))
  (assert-equal '() (map car '())))

;;; ports

(deftest (output-to-string)
  (assert-equal "ciao42"
                (with-output-to-string
                  (lambda ()
                    (display "ciao")
                    (format t "~a" 42)))))

(deftest (output-restored)
  (let ((old (current-output-port)))
    (with-output-to-string (lambda () (display "x")))
    (assert (eq? old (current-output-port)))))

(deftest (output-restored-on-error)
  (let ((old (current-output-port)))
    (condition-case
        err
        (with-output-to-string (lambda () (signal 'boom nil)))
      (boom nil))
    (assert (eq? old (current-output-port)))))

(deftest (input-from-string)
  (assert-equal ?a
                (with-input-from-string "abc"
                  (lambda () (read-char)))))

(deftest (input-restored)
  (let ((old (current-input-port)))
    (with-input-from-string "abc" (lambda () (read-char)))
    (assert (eq? old (current-input-port)))))

;;; assertions

(deftest (assert-fails)
  (assert-error 'test-failed (assert nil)))

(deftest (assert-equal-fails)
  (assert-error 'test-failed (assert-equal 1 2)))

(deftest (assert-error-no-error)
  (assert-error 'test-failed (assert-error 'type-error 1)))

(deftest (assert-error-wrong-error)
  (assert-error 'test-failed (assert-error 'arith-error (car 5))))

(deftest (assert-error-right-error)
  (assert-error 'type-error (car 5)))


(test-run)
