;;; tests for the prelude

;;; macroexpand

(defmacro (mx-if c a b)
  `(if ,c ,a ,b))

(defmacro (mx-not x)
  `(mx-if ,x nil t))

(defmacro (mx-when c . body)
  `(if ,c (progn ,@body) nil))

(deftest (macroexpand-define-short)
  (assert-equal '(define f (lambda (a) a))
                (macroexpand-all '(define (f a) a))))

(deftest (macroexpand-define-normal)
  (assert-equal '(define f 1) (macroexpand-all '(define f 1))))

(deftest (macroexpand-define-body)
  (assert-equal '(define f (lambda (x) (if x 1 2)))
                (macroexpand-all '(define (f x) (mx-if x 1 2)))))

(deftest (macroexpand-defmacro)
  (assert-equal '(define m (cons 'macro (lambda (x) x)))
                (macroexpand-all '(defmacro (m x) x))))

(deftest (macroexpand-lambda-body)
  (assert-equal '(lambda (x) (if x 1 2))
                (macroexpand-all '(lambda (x) (mx-if x 1 2)))))

(deftest (macroexpand-quote)
  (assert-equal ''(mx-if t 1 2) (macroexpand-all ''(mx-if t 1 2))))

(deftest (macroexpand-nested)
  (assert-equal '(if (if x nil t) 1 2)
                (macroexpand-all '(mx-if (mx-not x) 1 2))))

(deftest (macroexpand-1-one-step)
  (assert-equal '(if t 1 2) (macroexpand-1 '(mx-if t 1 2)))
  (assert-equal '(mx-if x nil t) (macroexpand-1 '(mx-not x))))

(deftest (macroexpand-1-rest)
  (assert-equal '(if c (progn a b) nil) (macroexpand-1 '(mx-when c a b))))

(deftest (macroexpand-1-not-macro)
  (assert-equal '(car x) (macroexpand-1 '(car x)))
  (assert-equal 1 (macroexpand-1 1)))

(deftest (eval-expands)
  (assert-equal 1 (eval '(mx-if t 1 2))))

(deftest (eval-noexpand-does-not-expand)
  (assert-error 'invalid-func-error (eval-noexpand '(mx-if t 1 2))))

;;; quasiquote

(deftest (qq-plain)
  (assert-equal '(a b c) `(a b c)))

(deftest (qq-unquote)
  (assert-equal '(1 2 3) `(1 ,(+ 1 1) 3)))

(deftest (qq-unquote-splicing)
  (assert-equal '(1 2 3 4) `(1 ,@(list 2 3) 4)))

(deftest (qq-quoted-unquote)
  (let ((x 'a))
    (assert-equal '(quote a) `',x)))

(deftest (qq-unquote-outside)
  (assert-error 'syntax-error (macroexpand-1 '(unquote x))))

(deftest (qq-unquote-splicing-outside)
  (assert-error 'syntax-error (macroexpand-1 '(unquote-splicing x))))

;;; cxr

(deftest (cxr-two-levels)
  (assert-equal 1 (caar '((1) 2)))
  (assert-equal '() (cdar '((1) 2)))
  (assert-equal 3 (caddr '(1 2 3))))

(deftest (cxr-three-levels)
  (assert-equal 1 (caaar '(((1)))))
  (assert-equal '(4) (cdddr '(1 2 3 4))))

;;; control

(deftest (and-values)
  (assert-equal 3 (and 1 2 3))
  (assert-equal '() (and 1 nil 3))
  (assert-equal 1 (and 1))
  (assert-equal t (and)))

(deftest (and-short-circuit)
  (assert-equal '() (and nil (car 1))))

(deftest (or-values)
  (assert-equal 2 (or nil 2 3))
  (assert-equal '() (or nil nil))
  (assert-equal 1 (or 1))
  (assert-equal '() (or)))

(deftest (or-short-circuit)
  (assert-equal 1 (or 1 (car 1))))

(deftest (or-evaluates-once)
  (let ((n 0))
    (or (progn (set! n (+ n 1)) n) 99)
    (assert-equal 1 n)))

(deftest (or-no-capture)
  (let ((tmp 5))
    (assert-equal 5 (or (car '(nil)) tmp))))

(deftest (cond-clauses)
  (assert-equal 2 (cond (nil 1) (t 2)))
  (assert-equal 1 (cond ((< 1 2) 1) (t 2)))
  (assert-equal '() (cond (nil 1)))
  (assert-equal '() (cond)))

(deftest (cond-short-circuit)
  (assert-equal 2 (cond (nil (car 1)) (t 2))))

;; clause body is an implicit progn, as in scheme and emacs lisp
(deftest (cond-progn)
  (assert-equal 2 (cond (t 1 2))))

(deftest (when-true)
  (assert-equal 2 (when t 1 2)))

(deftest (when-false)
  (assert-equal '() (when nil 1)))

(deftest (unless-true)
  (assert-equal '() (unless t 1)))

(deftest (unless-false)
  (assert-equal 1 (unless nil 1)))

;;; let

(deftest (let-simple)
  (assert-equal 3 (let ((a 1) (b 2)) (+ a b))))

(deftest (let-shadowing)
  (assert-equal 2 (let ((a 1)) (let ((a 2)) a))))

(deftest (let*-sequential)
  (assert-equal 2 (let* ((a 1) (b (+ a 1))) b)))

(deftest (let*-empty)
  (assert-equal 1 (let* () 1)))

;;; lists

(deftest (list-build)
  (assert-equal '(1 2 3) (list 1 2 3))
  (assert-equal '() (list)))

(deftest (map-apply)
  (assert-equal '(2 3 4) (map (lambda (x) (+ x 1)) '(1 2 3)))
  (assert-equal '() (map car '())))

;;; ports

(deftest (output-to-string)
  (assert-equal "ciao42"
                (with-output-to-string
                  (lambda ()
                    (display "ciao")
                    (format t "~a" 42)))))

(deftest (output-restored)
  (let ((old (current-output-port)))
    (with-output-to-string (lambda () (display "x")))
    (assert (eq? old (current-output-port)))))

(deftest (output-restored-on-error)
  (let ((old (current-output-port)))
    (condition-case
        err
        (with-output-to-string (lambda () (signal 'boom nil)))
      (boom nil))
    (assert (eq? old (current-output-port)))))

(deftest (input-from-string)
  (assert-equal ?a
                (with-input-from-string "abc"
                  (lambda () (read-char)))))

(deftest (input-restored)
  (let ((old (current-input-port)))
    (with-input-from-string "abc" (lambda () (read-char)))
    (assert (eq? old (current-input-port)))))

;;; assertions

(deftest (assert-fails)
  (assert-error 'test-failed (assert nil)))

(deftest (assert-equal-fails)
  (assert-error 'test-failed (assert-equal 1 2)))

(deftest (assert-error-no-error)
  (assert-error 'test-failed (assert-error 'type-error 1)))

(deftest (assert-error-wrong-error)
  (assert-error 'test-failed (assert-error 'arith-error (car 5))))

(deftest (assert-error-right-error)
  (assert-error 'type-error (car 5)))


(test-run)
