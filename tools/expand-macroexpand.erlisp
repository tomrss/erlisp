;; utility to expand macroexpand from macroexpand src.
;;
;; in other words: take real code for definining macroexpand
;; and expand it into unreadable mess; that's needed becasue
;; macroexpand code cannot contain anything else than C primitives

(define (dump-expanded src-path)
  (define (dump-expanded-sexp port)
    (let ((sexp (read port)))
      (unless (eof-object? sexp)
        (write (macroexpand-all sexp))
        (write-char ?\n)
        (dump-expanded-sexp port))))
  (call-with-port (open-input-file src-path)
    (lambda (port)
      (format t ";; this code is autogenerated from ~a.~%" src-path)
      (format t ";; do not edit by hand.~%")
      (dump-expanded-sexp port))))

;; TODO this is so specific because erlisp still cannot read cli args

(define src "lisp/macroexpand-src.erlisp")
(define dst "lisp/macroexpand.erlisp")

(define (expand-macroexpand)
  (with-output-to-file dst
    (lambda ()
      (dump-expanded src))))

(expand-macroexpand)
